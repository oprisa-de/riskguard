# RiskGuard Environment Variables
# This file is an example of the environment variables required to run RiskGuard.
# Create a .env file and replace the values below.

# Local LLM Configuration (Ollama)
# Ensure Ollama is running at http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# Cloud LLM Configuration (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database Configuration (Optional, for Phase 3)
DATABASE_URL=postgresql://user:password@localhost:5432/riskguard
